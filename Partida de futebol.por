programa {
  funcao inicio() {
   inteiro  gols_madureira,gols_bangu
   escreva("gols_madureira")
   leia(gols_madureira)
   escreva("gols_bangu")
   leia(gols_bangu)
   se(gols_madureira>gols_bangu){ 
   escreva("goleada do madureira")
   }
   senao se(gols_madureira==gols_bangu){ 
   escreva("empate")
   }
   senao se(gols_bangu>gols_madureira){
   escreva("goleada do bangu")
  }
}
}
  

