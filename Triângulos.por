programa {
  funcao inicio() {
     inteiro l1 , l2,  l3 
    


     escreva ("digite l1")
     leia(l1)
     escreva ("digite l2")
     leia(l2)
     escreva ("digite l3")
     leia(l3)
     
     se(l1==l2 e l2==l3)
     escreva("equilátero") 

  }

}


      
        
        
  

      

     
     


     

