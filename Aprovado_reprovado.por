programa {
  funcao inicio() {
    inteiro n1,n2,n3,n4,media
    escreva ("digite n1")
    leia (n1)
    escreva ("digite n2")
    leia (n2)
    escreva ("digite n3")
    leia (n3)
    escreva ("digite n4")
    leia (n4)
    media = (n1+n2+n3+n4)/4.0
    escreva ("a media e", media )
    se  (media >=7 )
       escreva ("Aprovado")
    senao {
       escreva ("Reprovado")
      }
    }
    
  }

  

  





    
