programa {
  funcao inicio() {
   inteiro ano_atual,ano_nascimento,idade
  escreva("digite ano_atual")  
  leia(ano_atual)
  escreva("digite ano_nascimento")
  leia(ano_nascimento)
  idade=ano_atual-ano_nascimento
  se(idade>21 )
    escreva ("você tem a maioridade")
  senao{
    escreva ("você não tem a maioridade")
 }
    
  } 
  }

