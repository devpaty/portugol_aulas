programa {
  funcao inicio() {
  inteiro ano_atual, ano_nascimento , idade
  escreva  ("ano_atual")
  leia  (ano_atual)
  escreva ("ano_nascimento")
  leia  (ano_nascimento )
  idade =(ano_atual-ano_nascimento)
  escreva("idade:", idade)
  se (idade>=18 ) {     
  escreva ("maior que 18 anos")
  }senao{
  escreva  ("menor de idade")
     }
  }
}



